{
  "name": "knotz-brigade-remake",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^20.19.0 || >=22.12.0" },
  "scripts": {
    "assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run assets",
    "dev": "vite --host 127.0.0.1 --port 5197 --strictPort",
    "check": "node scripts/check-engine.mjs && tsc --noEmit",
    "pretest": "npm run assets",
    "test": "node scripts/test-mission.mjs",
    "test:delivery": "node scripts/test-delivery.mjs",
    "test:rendered": "node scripts/test-rendered-flight.mjs",
    "test:production": "node scripts/test-production.mjs",
    "prebuild": "npm run assets && npm run check",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4297 --strictPort"
  },
  "dependencies": { "phaser": "4.2.1" },
  "devDependencies": { "playwright": "1.64.1", "pngjs": "7.0.0", "typescript": "7.0.2", "vite": "8.3.4" }
}
